# =============================================================================
# Hayatna Instant Win Campaign — Environment Configuration Template
# Copy this file to .env for local development (never commit the real .env).
# In Azure, set these as App Service Application Settings sourced from Key Vault
# references (@Microsoft.KeyVault(SecretUri=...)) — never hardcode secrets.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_NAME="Hayatna Instant Win"

# --- Database (Azure SQL Database in production; SQL Server-compatible locally) ---
# Format: sqlserver://HOST:1433;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=false
DATABASE_URL="sqlserver://localhost:1433;database=hayatna_campaign;user=sa;password=YourStrong!Passw0rd;encrypt=true;trustServerCertificate=true"

# --- Auth / JWT ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-64-byte-random-secret"
JWT_REFRESH_SECRET="replace-with-different-64-byte-random-secret"
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
ADMIN_SESSION_COOKIE_NAME=hayatna_admin_session

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ACCOUNT_NAME=hayatnastorage
AZURE_STORAGE_CONTAINER_RECEIPTS=receipts
AZURE_STORAGE_SAS_TTL_MIN=15

# --- Azure AI Document Intelligence (Form Recognizer) ---
AZURE_DOCINTEL_ENDPOINT=""
AZURE_DOCINTEL_KEY=""
AZURE_DOCINTEL_MODEL_ID=prebuilt-receipt

# When true (default for local dev with no Azure keys configured), the OCR and
# blob storage layers use deterministic local mocks so the full flow can be
# demoed end-to-end without any cloud credentials.
USE_MOCK_CLOUD_SERVICES=true

# --- Azure Key Vault (production secret source; App Service pulls via managed identity) ---
AZURE_KEY_VAULT_NAME=""

# --- Azure Application Insights / Monitor ---
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# --- Rate limiting / fraud thresholds (all configurable without redeploying via admin settings table) ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=20
MAX_SUBMISSIONS_PER_USER_PER_DAY=3
MIN_RECEIPT_CONFIDENCE=0.6
MIN_PURCHASE_AMOUNT_AED=0
FUZZY_MATCH_THRESHOLD=0.72

# --- Redis (optional, for distributed rate limiting across multiple App Service instances) ---
REDIS_URL=""

# --- SMS / OTP provider (optional; falls back to console-logged OTP in dev) ---
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID=HAYATNA

# --- Seed / admin bootstrap (used only by prisma/seed.ts) ---
SEED_ADMIN_EMAIL=admin@hayatna.ae
SEED_ADMIN_PASSWORD=ChangeMe123!
